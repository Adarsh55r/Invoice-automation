        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You extract invoice data. Return ONLY JSON with this shape:\n       {\"vendor\": string, \"invoice_no\": string, \"currency\": string,\n        \"invoice_date\": \"YYYY-MM-DD\", \"due_date\": \"YYYY-MM-DD\",\n        \"subtotal\": number, \"tax\": number, \"total\": number,\n        \"line_items\": [{\"description\": string, \"qty\": number, \"unit_price\": number, \"amount\": number}]}\n       Use null for any field you cannot find. Never guess."
            },
            {
              "content": "=Extract the data from this invoice text:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -1088,
        -816
      ],
      "id": "c9bc0fc9-0a35-445d-a495-fdc9fd847f85",
      "name": "LLM Extract",
      "credentials": {
        "openAiApi": {
          "id": "s8KwcQC9rJTYeqbK",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// Your n8n version returns the answer at output[0].content[0].text\nlet text = raw.output?.[0]?.content?.[0]?.text\n        ?? raw.message?.content\n        ?? raw.content\n        ?? raw.text\n        ?? '';\n\nlet data = null;\nlet error = null;\ntry {\n  const cleaned = String(text).replace(/```json|```/g, '').trim();\n  data = JSON.parse(cleaned);\n} catch (e) {\n  error = e.message;\n}\n\nreturn [{\n  json: {\n    parsed: data,\n    parse_ok: data !== null,\n    parse_error: error\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -816,
        -816
      ],
      "id": "29343e33-0bff-476a-9214-976c93e1e2a4",
      "name": "Parse LLM JSON"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name FROM vendors WHERE lower(name) = lower($1)",
        "options": {
          "queryReplacement": "={{ [ $json.parsed.vendor || '' ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1696,
        -400
      ],
      "id": "3ef93934-2fdd-4316-9f42-77db1c232b72",
      "name": "Vendor Lookup",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "Sb6mreBKArrNSsV5",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const p = $('Parse LLM JSON').first().json.parsed;\nconst vendorRow = $input.first().json;\nconst issues = [];\nlet score = 100;\n\nif (!p) {\n  return [{ json: { invoice: null, confidence: 0, issues: ['LLM output not valid JSON'], dedupe_key: null } }];\n}\n\nfor (const f of ['vendor', 'invoice_no', 'total', 'due_date']) {\n  if (p[f] === null || p[f] === undefined || p[f] === '') {\n    issues.push(`missing ${f}`); score -= 25;\n  }\n}\nif (p.due_date && isNaN(Date.parse(p.due_date))) {\n  issues.push('due_date not parseable'); score -= 15;\n}\nconst items = p.line_items || [];\nconst sum = items.reduce((s, i) => s + (Number(i.amount) || 0), 0);\nif (items.length && p.subtotal != null && Math.abs(sum - p.subtotal) > 0.01) {\n  issues.push(`line items (${sum}) != subtotal (${p.subtotal})`); score -= 30;\n}\nif (p.subtotal != null && p.tax != null && p.total != null &&\n    Math.abs(p.subtotal + p.tax - p.total) > 0.01) {\n  issues.push('subtotal + tax != total'); score -= 30;\n}\nif (!vendorRow.id) {\n  issues.push('vendor not in vendor master'); score -= 20;\n}\n\nreturn [{\n  json: {\n    invoice: p,\n    confidence: Math.max(score, 0),\n    issues,\n    dedupe_key: `${(p.vendor || '').toLowerCase()}|${p.invoice_no}|${p.total}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1440,
        -400
      ],
      "id": "9d92779c-c354-4762-b093-6083bdf9bea5",
      "name": "Validate and Score"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "   INSERT INTO invoices\n     (vendor, invoice_no, amount, tax, currency, due_date, line_items, confidence, issues, status, dedupe_hash)\n   VALUES\n     ($1, $2, $3, $4, $5, $6, $7::jsonb, $8, $9::jsonb, 'pending', md5($10))\n   ON CONFLICT (dedupe_hash) DO NOTHING\n   RETURNING id;",
        "options": {
          "queryReplacement": "=   {{ [      $json.invoice.vendor,      $json.invoice.invoice_no,      $json.invoice.total,      $json.invoice.tax,      $json.invoice.currency,      $json.invoice.due_date,      JSON.stringify($json.invoice.line_items),      $json.confidence,      JSON.stringify($json.issues),      $json.dedupe_key    ] }}"
        }
      },
