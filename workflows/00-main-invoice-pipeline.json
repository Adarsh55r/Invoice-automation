    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// Your n8n version returns the answer at output[0].content[0].text\nlet text = raw.output?.[0]?.content?.[0]?.text\n        ?? raw.message?.content\n        ?? raw.content\n        ?? raw.text\n        ?? '';\n\nlet data = null;\nlet error = null;\ntry {\n  const cleaned = String(text).replace(/```json|```/g, '').trim();\n  data = JSON.parse(cleaned);\n} catch (e) {\n  error = e.message;\n}\n\nreturn [{\n  json: {\n    parsed: data,\n    parse_ok: data !== null,\n    parse_error: error\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2000,
        -944
      ],
      "id": "29343e33-0bff-476a-9214-976c93e1e2a4",
      "name": "Parse LLM JSON"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name FROM vendors WHERE lower(name) = lower($1)",
        "options": {
          "queryReplacement": "={{ [ $json.parsed.vendor || '' ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1696,
        -944
      ],
      "id": "3ef93934-2fdd-4316-9f42-77db1c232b72",
      "name": "Vendor Lookup",
      "alwaysOutputData": true,
