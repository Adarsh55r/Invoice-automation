            {
              "role": "system",
              "content": "You extract invoice data. Return ONLY JSON with this shape:\n       {\"vendor\": string, \"invoice_no\": string, \"currency\": string,\n        \"invoice_date\": \"YYYY-MM-DD\", \"due_date\": \"YYYY-MM-DD\",\n        \"subtotal\": number, \"tax\": number, \"total\": number,\n        \"line_items\": [{\"description\": string, \"qty\": number, \"unit_price\": number, \"amount\": number}]}\n       Use null for any field you cannot find. Never guess.\ndue_date must be null unless the document explicitly shows a due date or payment terms. Never copy invoice_date into due_date."
            },
            {
              "content": "=Extract the data from this invoice text:\n{{ $json.text }}"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -2336,
        -1232
      ],
      "id": "c9bc0fc9-0a35-445d-a495-fdc9fd847f85",
      "name": "LLM Extract",
      "credentials": {
        "openAiApi": {
          "id": "s8KwcQC9rJTYeqbK",
          "name": "OpenAI account"
        }
