    {
      "parameters": {
        "jsCode": "const p = $('Parse LLM JSON').first().json.parsed;\nconst vendorRow = $input.first().json;\nconst issues = [];\nlet score = 100;\nconst ROUND_TOLERANCE = 1.0;\nconst AUTO_POST_THRESHOLD = 80;\n\nif (!p) {\n  return [{ json: {\n    invoice: null, confidence: 0,\n    issues: ['LLM output not valid JSON'],\n    dedupe_key: null, route: 'review',\n    route_reason: 'unparseable LLM output'\n  } }];\n}\n\n// Hard requirements\nfor (const f of ['vendor', 'invoice_no', 'total']) {\n  if (p[f] === null || p[f] === undefined || p[f] === '') {\n    issues.push(`missing ${f}`); score -= 25;\n  }\n}\n// Soft requirement: receipts often have no due date\nif (!p.due_date) {\n  issues.push('missing due_date'); score -= 10;\n} else if (isNaN(Date.parse(p.due_date))) {\n  issues.push('due_date not parseable'); score -= 15;\n}\n\n// Line items may be pre-tax or tax-inclusive\nconst items = p.line_items || [];\nconst sum = items.reduce((s, i) => s + (Number(i.amount) || 0), 0);\nif (items.length && p.subtotal != null && p.total != null) {\n  const okSub = Math.abs(sum - p.subtotal) <= ROUND_TOLERANCE;\n  const okTot = Math.abs(sum - p.total) <= ROUND_TOLERANCE;\n  if (!okSub && !okTot) {\n    issues.push(`line items (${sum.toFixed(2)}) match neither subtotal nor total`);\n    score -= 30;\n  }\n}\n\nif (p.subtotal != null && p.tax != null && p.total != null &&\n    Math.abs(p.subtotal + p.tax - p.total) > ROUND_TOLERANCE) {\n  issues.push('subtotal + tax != total'); score -= 30;\n}\n\nconst vendorKnown = Boolean(vendorRow.id);\nif (!vendorKnown) {\n  issues.push('vendor not in vendor master'); score -= 20;\n}\n\nscore = Math.max(score, 0);\n\n// Routing decision: score threshold PLUS hard rules\nlet route = 'auto_post';\nlet route_reason = 'score ok and vendor known';\nif (!vendorKnown) {\n  route = 'review'; route_reason = 'unknown vendor always needs review';\n} else if (score < AUTO_POST_THRESHOLD) {\n  route = 'review'; route_reason = `score ${score} below ${AUTO_POST_THRESHOLD}`;\n}\n\nreturn [{\n  json: {\n    invoice: p,\n    confidence: score,\n    issues,\n    dedupe_key: `${(p.vendor || '').toLowerCase()}|${p.invoice_no}|${p.total}`,\n    route,\n    route_reason\n  }\n}];"
      },
